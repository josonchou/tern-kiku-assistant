-- Run in Tern's actual Luau runtime; Git helpers and safety module are provided by the runner.
return function(M, manager, removal)
    local checks = 0
    local function eq(actual, expected)
        assert(actual == expected, tostring(actual) .. " != " .. tostring(expected))
        checks += 1
    end
    eq(M.branchName("feature/login page"), "feature/login-page")
    eq(M.parent("/repo"), "/")
    eq(M.parent("/a/b"), "/a")
    eq(M.absolute("../a/./b", "/repo", "/home/u"), "/a/b")
    eq(M.absolute("~/trees", "/repo", "/home/u"), "/home/u/trees")
    eq(M.absolute("~", "/repo", "/home/u"), "/home/u")
    eq(M.absolute("~other/trees", "/repo", "/home/u"), nil)
    eq(M.absolute("", "/repo", "/home/u"), nil)
    eq(M.absolute("x\ny", "/repo", "/home/u"), nil)
    local trees = M.worktrees("worktree /repos/main\0HEAD abcd\0branch refs/heads/main\0\0worktree /trees/a \"中文\"\npath\0HEAD abcd\0detached\0\0")
    eq(#trees, 2)
    eq(trees[2].path, "/trees/a \"中文\"\npath")
    eq(trees[2].detached, true)
    eq(trees[2].head, "abcd")
    local protected = M.worktrees("worktree /locked\0HEAD deadbeef\0branch refs/heads/locked\0locked operator maintenance\0\0worktree /stale\0HEAD feedface\0detached\0prunable missing directory\0\0")
    eq(protected[1].locked, true)
    eq(protected[1].lockReason, "operator maintenance")
    eq(protected[2].prunable, true)
    eq(protected[2].prunableReason, "missing directory")
    eq(M.occupied(trees)["refs/heads/main"], "/repos/main")
    local branches = M.branches("refs/heads/main\0\0\nrefs/remotes/origin/HEAD\0refs/remotes/origin/topic\0\nrefs/remotes/origin/feature/a\0\0\n")
    eq(#branches, 2)
    eq(branches[2].localName, "feature/a")
    local simple = {{path = "/repos/main"}}
    eq(M.targets(simple, "/repos/main", "", "feature/a", "/home/u")[1], "/repos/feature/a")
    local linked = {{path = "/repos/main"}, {path = "/trees/a"}, {path = "/other/b"}, {path = "/trees/c"}}
    local targets = M.targets(linked, "/other/b", "../trees", "feature/a", "/home/u")
    eq(#targets, 3)
    eq(targets[1], "/other/feature/a")
    eq(targets[2], "/trees/feature/a")
    eq(targets[3], "/repos/trees/feature/a")
    eq(#M.targets(linked, "/trees/a", "/trees", "a", "/home/u"), 2)
    eq(manager.sameWorktree("/repo/tree", "/repo/.git", "/repo/other", "/repo/.git"), false)
    local matches = manager.tabCandidates({
        {pane = 1, cwd = "/repo/tree/sub", tab = 11, sessionId = 1, sessionHost = 7, hostId = 7},
        {pane = 2, cwd = "/repo/tree", tab = 13, sessionId = 1, sessionHost = 8, hostId = 7},
        {pane = 3, cwd = "/repo/tree", tab = 12, sessionId = 2, sessionHost = 8, hostId = 8},
    }, "/repo/tree", "/repo/.git", {
        [1] = {root = "/repo/tree", commonDir = "/repo/.git"},
        [2] = {root = "/repo/tree", commonDir = "/repo/.git"},
        [3] = {root = "/repo/tree", commonDir = "/repo/.git"},
    }, 7)
    eq(#matches, 1)
    eq(removal.contains("/repo/tree", "/repo/tree/nested"), true)
    eq(removal.contains("/repo/tree", "/repo/tree-other"), false)
    eq(removal.contains("/", "/x"), true)
    eq(removal.fileURLPath("FILE:///repo/Upper%25Name"), "/repo/Upper%Name")
    eq(removal.fileURLPath("file://localhost/repo/a%20b"), "/repo/a b")
    local badEncoding = pcall(function() removal.fileURLPath("FILE:///repo/%XZ") end)
    eq(badEncoding, false)
    local nulEncoding = pcall(function() removal.fileURLPath("file:///repo/%00") end)
    eq(nulEncoding, false)
    local remoteURL = pcall(function() removal.fileURLPath("file://remotehost/repo/file") end)
    eq(remoteURL, false)
    removal.requireCompleteFiles("", "", "H 100644 deadbeef 0\tREADME.md\0")
    local malformedIndex = pcall(function()
        removal.requireCompleteFiles("", "", "H 100999 deadbeef 0\tREADME.md\0")
    end)
    eq(malformedIndex, false)
    local malformedRecord = pcall(function()
        removal.requireCompleteFiles("", "", "H 100644 deadbeef README.md\0")
    end)
    eq(malformedRecord, false)
    eq(removal.fileURLPath("file:///repo/My%20File.txt"), "/repo/My File.txt")
    local protected = pcall(function()
        removal.requireCompleteFiles("nested-repo/\0", "", "")
    end)
    eq(protected, false)
    local submodule = pcall(function()
        removal.requireCompleteFiles("", "", "H 160000 deadbeef 0\tsubmodule\0")
    end)
    eq(submodule, false)
    local hidden = pcall(function()
        removal.requireCompleteFiles("", "", "h 100644 deadbeef 0\tREADME.md\0")
    end)
    eq(hidden, false)
    local skipped = pcall(function()
        removal.requireCompleteFiles("", "", "S 100644 deadbeef 0\tREADME.md\0")
    end)
    eq(skipped, false)
    local warningResult = pcall(function()
        removal.result({ status = 0, timed_out = false, stdout = "", stderr = "warning" }, "probe")
    end)
    eq(warningResult, false)
    eq(removal.sameSnapshot({{key="a", value="1"}}, {{key="a", value="1"}}), true)
    eq(removal.sameSnapshot({{key="a", value="1"}}, {{key="a", value="2"}}), false)
    removal.validateRefSnapshot("refs/heads/main\0deadbeef\0\n")
    local incompleteRefs = pcall(function()
        removal.validateRefSnapshot("refs/heads/main\0")
    end)
    eq(incompleteRefs, false)
    eq(matches[1].pane, 1)
    return checks
end
